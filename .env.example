VISIONGUARD_ENV=development
VISIONGUARD_HOST=127.0.0.1
VISIONGUARD_PORT=8000
VISIONGUARD_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VISIONGUARD_MAX_UPLOAD_MB=500
VISIONGUARD_CLIP_SAMPLE_SECONDS=1.0
VISIONGUARD_ANALYSIS_FPS=2.0
VISIONGUARD_POSE_FPS=5.0
VISIONGUARD_PROCESS_WIDTH=640
VISIONGUARD_DETECTION_THRESHOLD=0.45
VISIONGUARD_DEVICE=auto
VISIONGUARD_AUTH_SECRET=replace-with-at-least-32-random-bytes
VISIONGUARD_AUTH_TOKEN_MINUTES=480
VISIONGUARD_AUTH_COOKIE_SECURE=false
VISIONGUARD_LOGIN_RATE_LIMIT_ATTEMPTS=5
VISIONGUARD_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# CLI-only local credentials. Prefer an injected bearer token in automated environments.
# VISIONGUARD_API_EMAIL=admin@example.local
# VISIONGUARD_API_PASSWORD=set-outside-source-control

# SQLite remains the recoverable local fallback. PostgreSQL Sprint 5A uses the
# application-role URL generated from .env.postgres.
# VISIONGUARD_DATABASE_URL=postgresql+psycopg://visionguard_app:change-me@127.0.0.1:54329/visionguard
# VISIONGUARD_MIGRATION_DATABASE_URL=postgresql+psycopg://visionguard_migrator:change-me@127.0.0.1:54329/visionguard
